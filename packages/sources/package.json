{
  "name": "@chilekit/sources",
  "version": "0.2.0",
  "description": "Conectores y manifiestos de fuentes publicas chilenas para ChileKit.",
  "keywords": [
    "chile",
    "datos-abiertos",
    "feriados",
    "indicadores-economicos",
    "open-data"
  ],
  "homepage": "https://github.com/ferando855/chilekit/tree/main/packages/sources#readme",
  "bugs": {
    "url": "https://github.com/ferando855/chilekit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferando855/chilekit.git",
    "directory": "packages/sources"
  },
  "license": "MIT",
  "author": "ferando855 (https://github.com/ferando855)",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "clean": "rm -rf dist",
    "test": "vitest run --config ../../vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chilekit/core": "workspace:*",
    "@clregions/data": "1.0.0"
  }
}
