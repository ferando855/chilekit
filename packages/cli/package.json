{
  "name": "@chilekit/cli",
  "version": "0.1.0",
  "description": "CLI agent-friendly para consultar datos publicos chilenos.",
  "keywords": [
    "chile",
    "cli",
    "agents",
    "ai",
    "datos-publicos",
    "feriados",
    "uf",
    "dias-habiles"
  ],
  "homepage": "https://github.com/ferando855/chilekit/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/ferando855/chilekit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferando855/chilekit.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "ferando855 (https://github.com/ferando855)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "chilekit": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --sourcemap --clean",
    "chilekit": "tsx src/bin.ts",
    "clean": "rm -rf dist",
    "test": "vitest run --config ../../vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@chilekit/core": "workspace:*",
    "@chilekit/mcp": "workspace:*",
    "@chilekit/sources": "workspace:*",
    "commander": "15.0.0"
  }
}
