{
  "name": "@chilekit/core",
  "version": "0.3.0",
  "description": "Tipos y utilidades base de ChileKit.",
  "keywords": [
    "chile",
    "rut",
    "utilidades"
  ],
  "homepage": "https://github.com/ferando855/chilekit/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/ferando855/chilekit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferando855/chilekit.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "ferando855 (https://github.com/ferando855)",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "clean": "rm -rf dist",
    "test": "vitest run --config ../../vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
