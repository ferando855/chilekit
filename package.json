{
  "name": "chilekit",
  "version": "0.3.0",
  "private": true,
  "description": "CLI y MCP open-source para consultar datos publicos chilenos.",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "audit": "pnpm audit --audit-level moderate",
    "build": "pnpm -r run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm smoke && pnpm run audit",
    "clean": "pnpm -r run clean",
    "format": "biome check --write .",
    "lint": "biome check .",
    "smoke": "node scripts/smoke.mjs",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "keywords": [
    "chile",
    "cli",
    "mcp",
    "datos-publicos",
    "open-data"
  ],
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.4",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferando855/chilekit.git"
  }
}
